---
import ModulePage from "@/views/ModulePage.astro";
import { getSiteContent } from "@/lib/content";

export async function getStaticPaths() {
  const site = await getSiteContent("pt");
  return site.moduleIdsWithContent.map((id) => ({ params: { id } }));
}
---

<ModulePage lang="pt" id={Astro.params.id!} />
