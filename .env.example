# Site (Astro) — lido no build. Sem SANITY_PROJECT_ID o site usa o conteúdo
# local de src/lib/data.ts e src/lib/modulesContent.ts.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Opcional: só necessário se o dataset for privado (token com permissão Viewer).
SANITY_READ_TOKEN=
# Opcional: versão da API do Sanity (padrão 2025-01-01).
# SANITY_API_VERSION=2025-01-01
